<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.zidane.agent</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__INSTALL_DIR__/run-with-env.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ZIDANE_AGENT_INSTALL_DIR</key><string>__INSTALL_DIR__</string>
    <key>ZIDANE_AGENT_ENV_FILE</key><string>__ENV_FILE__</string>
  </dict>
  <key>WorkingDirectory</key><string>__INSTALL_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>__DATA_DIR__/service.stdout.log</string>
  <key>StandardErrorPath</key><string>__DATA_DIR__/service.stderr.log</string>
</dict>
</plist>
